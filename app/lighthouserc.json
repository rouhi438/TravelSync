{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "staticDistDir": "./dist",
      "isSinglePageApplication": true,
      "url": [
        "/",
        "/explore",
        "/login",
        "/register",
        "/cart",
        "/wishlist",
        "/package/1",
        "/booking",
        "/checkout"
      ],
      "settings": {
        "onlyCategories": ["accessibility"]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouse-reports"
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
