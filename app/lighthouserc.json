{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "staticDistDir": "./dist",
      "isSinglePageApplication": true,
      "url": [
        "http://localhost:53727",
        "http://localhost:53727/explore",
        "http://localhost:53727/login",
        "http://localhost:53727/register",
        "http://localhost:53727/cart",
        "http://localhost:53727/wishlist",
        "http://localhost:53727/package/1",
        "http://localhost:53727/booking",
        "http://localhost:53727/checkout"
      ],
      "settings": {
        "onlyCategories": ["accessibility"],
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage --disable-gpu --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouse-reports"
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
