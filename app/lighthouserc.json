{
  "ci": {
    "collect": {
      "url": ["http://localhost:4000/"],
      "startServerCommand": "http-server ./dist -p 4000 -g",
      "startServerReadyPattern": "Available on",
      "numberOfRuns": 1
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "preset": "lighthouse:recommended"
    }
  }
}
